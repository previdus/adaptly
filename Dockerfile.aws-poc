FROM node:22-bookworm AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/install-ci.mjs scripts/sites-env.mjs scripts/tool-environment.mjs scripts/execution-profile.mjs scripts/npm-install.mjs ./scripts/
RUN npm run install:ci && npm cache clean --force
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8787
COPY --from=build /app /app
EXPOSE 8787

CMD ["sh", "./scripts/start-aws-poc.sh"]
